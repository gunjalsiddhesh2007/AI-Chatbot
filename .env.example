GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_OUTPUT_TOKENS=2048
FLASK_SECRET_KEY=replace_with_a_long_random_secret
DATABASE_PATH=chatbot.db
# Optional hosted PostgreSQL connection URL. When set, it takes precedence over DATABASE_PATH.
DATABASE_URL=
RATE_LIMIT=10 per hour
CONTEXT_WINDOW=20
CONTEXT_MAX_CHARS=24000

# Groq is tried if Gemini is not configured or a Gemini request fails.
GROQ_API_KEY=your_groq_api_key
GROQ_API_KEY_2=your_backup_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
AI_PROVIDER_TIMEOUT_SECONDS=20
